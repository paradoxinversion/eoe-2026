{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AgentView",
    "type": "object",
    "required": ["agentId", "person"],
    "properties": {
        "agentId": { "type": "string" },
        "role": { "type": ["string", "null"] },
        "person": {
            "type": "object",
            "required": ["id", "firstName", "lastName", "homeZoneId"],
            "properties": {
                "id": { "type": "string" },
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "homeZoneId": { "type": "string" },
                "skills": { "type": ["object", "array", "null"] },
                "attributes": { "type": ["object", "null"] }
            }
        }
    }
}
