{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "World Generation Debug Schema",
    "type": "object",
    "properties": {
        "zones": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "gridX",
                    "gridY",
                    "wealth",
                    "intelligenceLevel"
                ],
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "gridX": { "type": "number" },
                    "gridY": { "type": "number" },
                    "size": { "type": "number" },
                    "wealth": { "type": "number" },
                    "intelligenceLevel": { "type": "number" },
                    "capacity": { "type": ["string", "null"] },
                    "governingOrganization": { "type": "string" },
                    "buildings": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "people": { "type": "array", "items": { "type": "string" } }
                }
            }
        },
        "people": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "firstName",
                    "lastName",
                    "intelligenceLevel",
                    "attributes",
                    "skills"
                ],
                "properties": {
                    "id": { "type": "string" },
                    "firstName": { "type": "string" },
                    "lastName": { "type": "string" },
                    "homeZoneId": { "type": "string" },
                    "governingOrganizationSentiments": { "type": "object" },
                    "intelligenceLevel": { "type": "number" },
                    "occupation": { "type": "string" },
                    "attributes": {
                        "type": "object",
                        "required": [
                            "health",
                            "intelligence",
                            "strength",
                            "agility",
                            "endurance",
                            "empathy",
                            "charisma"
                        ],
                        "properties": {
                            "health": { "type": "number" },
                            "intelligence": { "type": "number" },
                            "strength": { "type": "number" },
                            "agility": { "type": "number" },
                            "endurance": { "type": "number" },
                            "empathy": { "type": "number" },
                            "charisma": { "type": "number" }
                        }
                    },
                    "skills": {
                        "type": "object",
                        "required": [
                            "fighting",
                            "medicine",
                            "business",
                            "finance",
                            "publicPlanning",
                            "science"
                        ],
                        "properties": {
                            "fighting": { "type": "number" },
                            "medicine": { "type": "number" },
                            "business": { "type": "number" },
                            "finance": { "type": "number" },
                            "publicPlanning": { "type": "number" },
                            "science": { "type": "number" }
                        }
                    }
                }
            }
        },
        "buildings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name", "type", "size", "zoneId"],
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": {
                        "type": "string",
                        "enum": [
                            "Residence",
                            "Office",
                            "Lab",
                            "Bank",
                            "Hospital"
                        ]
                    },
                    "size": { "type": "number" },
                    "zoneId": { "type": "string" },
                    "intelligenceLevel": { "type": "number" },
                    "upkeepCost": { "type": "number" },
                    "infrastructureLoad": { "type": "number" }
                }
            }
        },
        "organizations": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "leaderId": { "type": "string" }
                }
            }
        }
    },
    "required": ["zones", "people", "buildings", "organizations"]
}
