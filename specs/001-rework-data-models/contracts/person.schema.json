{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Person",
    "type": "object",
    "required": [
        "id",
        "firstName",
        "lastName",
        "governingOrganizationSentiments",
        "intelligenceLevel",
        "attributes",
        "skills"
    ],
    "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string", "minLength": 1 },
        "lastName": { "type": "string", "minLength": 0 },
        "homeZoneId": { "type": ["string", "null"] },
        "governingOrganizationSentiments": {
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
            }
        },
        "intelligenceLevel": { "type": "number", "minimum": 0, "maximum": 100 },
        "occupation": { "type": "string" },
        "attributes": {
            "type": "object",
            "required": [
                "health",
                "intelligence",
                "strength",
                "agility",
                "endurance",
                "empathy",
                "charisma"
            ],
            "properties": {
                "health": { "type": "number" },
                "intelligence": { "type": "number" },
                "strength": { "type": "number" },
                "agility": { "type": "number" },
                "endurance": { "type": "number" },
                "empathy": { "type": "number" },
                "charisma": { "type": "number" }
            }
        },
        "skills": {
            "type": "object",
            "required": [
                "fighting",
                "medicine",
                "business",
                "finance",
                "publicPlanning",
                "science"
            ],
            "properties": {
                "fighting": { "type": "number" },
                "medicine": { "type": "number" },
                "business": { "type": "number" },
                "finance": { "type": "number" },
                "publicPlanning": { "type": "number" },
                "science": { "type": "number" }
            }
        }
    },
    "additionalProperties": false
}
