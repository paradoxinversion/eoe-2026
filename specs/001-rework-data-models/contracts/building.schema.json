{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Building",
    "type": "object",
    "required": [
        "id",
        "name",
        "type",
        "size",
        "zoneId",
        "intelligenceLevel",
        "upkeepCost",
        "infrastructureLoad"
    ],
    "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
            "type": "string",
            "enum": ["Residence", "Office", "Lab", "Bank", "Hospital"]
        },
        "size": { "type": "number" },
        "zoneId": { "type": "string" },
        "intelligenceLevel": { "type": "number", "minimum": 0, "maximum": 100 },
        "upkeepCost": { "type": "number" },
        "infrastructureLoad": { "type": "number" }
    },
    "additionalProperties": false
}
