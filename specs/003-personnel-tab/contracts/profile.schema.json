{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Profile",
    "type": "object",
    "required": ["displayName", "confidence"],
    "properties": {
        "displayName": { "type": "string" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "summary": { "type": "string" }
    },
    "additionalProperties": false
}
