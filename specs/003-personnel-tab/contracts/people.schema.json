{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Person",
    "type": "object",
    "required": ["id", "name"],
    "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "intelligenceLevel": { "type": "integer", "minimum": 0, "maximum": 10 },
        "role": { "type": "string" },
        "zoneId": { "type": "string" }
    },
    "additionalProperties": false
}
