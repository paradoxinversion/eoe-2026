{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Empire of Evil - Config",
    "type": "object",
    "properties": {
        "playerName": { "type": "string", "minLength": 1 },
        "startingSeed": { "type": "integer", "minimum": 0 },
        "autosaveIntervalSeconds": { "type": "integer", "minimum": 5 },
        "gracePeriodDays": { "type": "integer", "minimum": 0 },
        "eventProbabilities": {
            "type": "object",
            "properties": {
                "raid": { "type": "number", "minimum": 0, "maximum": 1 },
                "blessing": { "type": "number", "minimum": 0, "maximum": 1 },
                "discovery": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
        },
        "named_configs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "created_at": { "type": "string", "format": "date-time" }
                },
                "required": ["name"]
            }
        },
        "organizationCount": { "type": "integer", "minimum": 1, "default": 5 },
        "mapWidth": { "type": "integer", "minimum": 1, "default": 10 },
        "mapHeight": { "type": "integer", "minimum": 1, "default": 10 }
    },
    "required": ["playerName", "startingSeed", "autosaveIntervalSeconds"],
    "additionalProperties": false
}
